# Copy this file to .env for local runs and fill in your real values.
# On GitHub you do NOT use this file; you add the same names under
# Settings -> Secrets and variables -> Actions instead.

# Adzuna (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Email sending. For Gmail, EMAIL_PASSWORD must be a 16-character App Password
# (turn on 2-Step Verification first, then create an App Password).
EMAIL_USERNAME=youraddress@gmail.com
EMAIL_PASSWORD=your16charapppassword
